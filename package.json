{
  "name": "platform",
  "version": "1.0.0",
  "private": true,
  "description": "Quiz Assessment and Examination Platform Monorepo",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch services/quiz/src/presentation/server.ts",
    "build": "npm run build --workspace=@platform/quiz-web && npm run build --workspace=@platform/admin-web && tsc --noEmit -p services/quiz/tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p services/quiz/tsconfig.json",
    "build:packages": "tsc -p packages/contracts/tsconfig.json && tsc -p packages/auth-client/tsconfig.json && tsc -p packages/api-client/tsconfig.json",
    "start": "tsx services/quiz/src/presentation/server.ts",
    "dev:quiz": "tsx watch services/quiz/src/presentation/server.ts",
    "dev:auth": "tsx watch services/auth/src/presentation/server.ts",
    "dev:web": "npm run dev --prefix apps/quiz-web",
    "dev:admin": "npm run dev --prefix apps/admin-web",
    "db:generate:auth": "drizzle-kit generate --config=services/auth/drizzle.config.ts",
    "db:migrate:auth": "tsx services/auth/src/infrastructure/db/migrate.ts",
    "db:seed:auth": "tsx services/auth/src/infrastructure/db/seed.ts",
    "db:generate:quiz": "drizzle-kit generate --config=services/quiz/drizzle.config.ts",
    "db:migrate:quiz": "tsx services/quiz/src/infrastructure/db/migrate.ts",
    "db:seed:quiz": "tsx services/quiz/src/infrastructure/db/seed.ts",
    "dev:taxonomy": "tsx watch services/taxonomy/src/presentation/server.ts",
    "db:generate:taxonomy": "drizzle-kit generate --config=services/taxonomy/drizzle.config.ts",
    "db:migrate:taxonomy": "tsx services/taxonomy/src/infrastructure/db/migrate.ts",
    "db:seed:taxonomy": "tsx services/taxonomy/src/infrastructure/db/seed.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
