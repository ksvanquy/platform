{
  "name": "platform",
  "version": "1.0.0",
  "private": true,
  "description": "Quiz Assessment and Examination Platform Monorepo",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch services/gateway/src/server.ts",
    "build": "npm run build --workspace=@platform/web && npm run build --workspace=@platform/admin-web && tsc --noEmit -p services/gateway/tsconfig.json",
    "build:frontend:cdn": "npm run build --workspace=@platform/web && npm run build --workspace=@platform/admin-web",
    "deploy:cdn": "tsx scripts/deploy-cdn.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit -p services/gateway/tsconfig.json",
    "build:packages": "tsc -p packages/contracts/tsconfig.json && tsc -p packages/security/tsconfig.json && tsc -p packages/auth-client/tsconfig.json && tsc -p packages/api-client/tsconfig.json",
    "start": "tsx services/gateway/src/server.ts",
    "dev:gateway": "tsx watch services/gateway/src/server.ts",
    "dev:auth": "tsx watch services/auth/src/presentation/server.ts",
    "dev:web": "npm run dev --prefix apps/web",
    "dev:admin": "npm run dev --prefix apps/admin-web",
    "db:generate:auth": "drizzle-kit generate --config=services/auth/drizzle.config.ts",
    "db:migrate:auth": "tsx services/auth/src/infrastructure/db/migrate.ts",
    "db:push:auth": "drizzle-kit push --config=services/auth/drizzle.config.ts",
    "db:seed:auth": "tsx services/auth/src/infrastructure/db/seed.ts",
    "dev:taxonomy": "tsx watch services/taxonomy/src/presentation/server.ts",
    "db:generate:taxonomy": "drizzle-kit generate --config=services/taxonomy/drizzle.config.ts",
    "db:migrate:taxonomy": "tsx services/taxonomy/src/infrastructure/db/migrate.ts",
    "db:push:taxonomy": "drizzle-kit push --config=services/taxonomy/drizzle.config.ts",
    "db:seed:taxonomy": "tsx services/taxonomy/src/infrastructure/db/seed.ts",
    "dev:question": "tsx watch services/question/src/presentation/server.ts",
    "db:generate:question": "drizzle-kit generate --config=services/question/drizzle.config.ts",
    "db:migrate:question": "tsx services/question/src/infrastructure/db/migrate.ts",
    "db:push:question": "drizzle-kit push --config=services/question/drizzle.config.ts",
    "db:seed:question": "tsx services/question/src/infrastructure/db/seed.ts",
    "dev:assessment": "tsx watch services/assessment/src/presentation/server.ts",
    "db:generate:assessment": "drizzle-kit generate --config=services/assessment/drizzle.config.ts",
    "db:migrate:assessment": "tsx services/assessment/src/infrastructure/db/migrate.ts",
    "db:push:assessment": "drizzle-kit push --config=services/assessment/drizzle.config.ts",
    "db:seed:assessment": "tsx services/assessment/src/infrastructure/db/seed.ts",
    "dev:exam": "tsx watch services/exam/src/presentation/server.ts",
    "db:generate:exam": "drizzle-kit generate --config=services/exam/drizzle.config.ts",
    "db:migrate:exam": "tsx services/exam/src/infrastructure/db/migrate.ts",
    "db:push:exam": "drizzle-kit push --config=services/exam/drizzle.config.ts",
    "db:seed:exam": "tsx services/exam/src/infrastructure/db/seed.ts",
    "dev:attempt": "tsx watch services/attempt/src/presentation/server.ts",
    "db:generate:attempt": "drizzle-kit generate --config=services/attempt/drizzle.config.ts",
    "db:migrate:attempt": "tsx services/attempt/src/infrastructure/db/migrate.ts",
    "db:push:attempt": "drizzle-kit push --config=services/attempt/drizzle.config.ts",
    "db:seed:attempt": "tsx services/attempt/src/infrastructure/db/seed.ts",
    "seed:all": "tsx scripts/bootstrap-clean-data.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "express": "^5.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  }
}
