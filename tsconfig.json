{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@platform/contracts": ["./packages/contracts/src/index.ts"],
      "@platform/contracts/*": ["./packages/contracts/src/*"],
      "@platform/security": ["./packages/security/src/index.ts"],
      "@platform/security/*": ["./packages/security/src/*"],
      "@platform/auth-service": ["./services/auth/src/index.ts"],
      "@platform/auth-service/*": ["./services/auth/src/*"],
      "@platform/taxonomy-service": ["./services/taxonomy/src/index.ts"],
      "@platform/taxonomy-service/*": ["./services/taxonomy/src/*"],
      "@platform/question-service": ["./services/question/src/index.ts"],
      "@platform/question-service/*": ["./services/question/src/*"],
      "@platform/assessment-service": ["./services/assessment/src/index.ts"],
      "@platform/assessment-service/*": ["./services/assessment/src/*"],
      "@platform/exam-service": ["./services/exam/src/index.ts"],
      "@platform/exam-service/*": ["./services/exam/src/*"],
      "@platform/attempt-service": ["./services/attempt/src/index.ts"],
      "@platform/attempt-service/*": ["./services/attempt/src/*"],
      "@platform/gateway-service": ["./services/gateway/src/index.ts"],
      "@platform/gateway-service/*": ["./services/gateway/src/*"],
      "@platform/api-client": ["./packages/api-client/src/index.ts"],
      "@platform/api-client/*": ["./packages/api-client/src/*"],
      "@platform/auth-client": ["./packages/auth-client/src/index.ts"],
      "@platform/auth-client/*": ["./packages/auth-client/src/*"]
    }
  },
  "include": ["services/gateway/src/**/*"],
  "exclude": ["services/gateway/src/**/*.spec.ts", "dist", "apps", "packages"]
}
