{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@platform/contracts": ["./packages/contracts/src/index.ts"],
      "@platform/contracts/*": ["./packages/contracts/src/*"],
      "@platform/auth-service": ["./services/auth/src/index.ts"],
      "@platform/auth-service/*": ["./services/auth/src/*"],
      "@platform/taxonomy-service": ["./services/taxonomy/src/index.ts"],
      "@platform/taxonomy-service/*": ["./services/taxonomy/src/*"],
      "@platform/quiz-service": ["./services/quiz/src/index.ts"],
      "@platform/quiz-service/*": ["./services/quiz/src/*"],
      "@platform/api-client": ["./packages/api-client/src/index.ts"],
      "@platform/api-client/*": ["./packages/api-client/src/*"],
      "@platform/auth-client": ["./packages/auth-client/src/index.ts"],
      "@platform/auth-client/*": ["./packages/auth-client/src/*"]
    }
  },
  "include": ["services/quiz/src/**/*"],
  "exclude": ["services/quiz/src/**/*.spec.ts", "services/quiz/tests", "dist", "apps", "packages"]
}
