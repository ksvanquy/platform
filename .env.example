# Auth Service Database Configuration (Database-per-Service Architecture)
AUTH_DATABASE_URL=postgres://postgres:root@localhost:5432/auth_db

# Cryptographic Token Keys (RS256 Private/Public key pair or HS256 secret)
JWT_PRIVATE_KEY=JWT_PRIVATE_KEY
JWT_PUBLIC_KEY=JWT_PRIVATE_KEY
JWT_SECRET=dev-quiz-platform-secret-key-32-chars-min
